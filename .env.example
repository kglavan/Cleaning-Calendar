# Server-side only (Vercel Environment Variables) - never expose these in the frontend

# Supabase project settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# iCal export URLs for this listing, one per platform:
# - Airbnb: Listing -> Calendar -> Availability -> Export Calendar
# - VRBO:   Listing -> Calendar -> Import/Export -> Export Calendar
# - Booking.com: Extranet -> Calendar -> Sync calendars -> Export calendar
ICAL_URL_AIRBNB=https://www.airbnb.com/calendar/ical/XXXXX.ics
ICAL_URL_VRBO=https://www.vrbo.com/icalendar/XXXXX.ics
ICAL_URL_BOOKING=https://admin.booking.com/hotel/hoteladmin/ical.html?XXXXX
