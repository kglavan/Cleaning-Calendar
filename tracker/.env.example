# Copy to tracker/.env. The Supabase project (SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY) and the Airbnb listing id are read from the
# calendar's own ../.env - the Airbnb id comes from ICAL_URL_AIRBNB - so only
# what the calendar doesn't know goes here.

# VRBO: the number in https://www.vrbo.com/1234567 (drop any trailing "ha")
VRBO_LISTING_ID=
# Booking.com: the slug in https://www.booking.com/hotel/us/<this-part>.html
BOOKING_HOTEL_SLUG=

# Optional: override the Airbnb id instead of reading it from the iCal link
# AIRBNB_LISTING_ID=

# How long to wait for you to clear VRBO's "Bot or Not?" check in the Chrome
# window before recording that search as blocked. 0 = don't wait.
VRBO_HUMAN_WAIT_MINUTES=3
